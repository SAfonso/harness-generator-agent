[
  {
    "id": 1,
    "title": "Inicializar entorno del proyecto",
    "status": "pending",
    "priority": "high",
    "complejidad": "baja",
    "depends_on": []
  },
  {
    "id": 2,
    "title": "Descomponer '{{ spec.deliverable }}' en tareas atómicas (planner)",
    "status": "pending",
    "priority": "high",
    "complejidad": "alta",
    "depends_on": [1]
  },
  {
    "id": 3,
    "title": "Validar criterios de aceptación",
    "status": "pending",
    "priority": "high",
    "complejidad": "media",
    "depends_on": [2]
  }{% for finding in spec.audit_findings %},
  {
    "id": {{ 3 + loop.index }},
    "title": "Arreglar: {{ finding.description }} — {{ finding.suggested_fix }}",
    "status": "pending",
    "priority": "{{ 'high' if finding.severity == 'blocking' else 'medium' }}",
    "complejidad": "{{ 'media' if finding.severity == 'blocking' else 'baja' }}",
    "depends_on": [1]
  }{% endfor %}
]
